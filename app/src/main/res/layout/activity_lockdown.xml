<?xml version="1.0" encoding="utf-8"?>
<!-- Lockdown running: timer, quick resets, end early. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Restudy.Screen"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    tools:context=".LockdownActivity">

    <TextView
        style="@style/Restudy.Pill.Accent"
        android:text="Lockdown running" />

    <!-- Timer -->
    <FrameLayout
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_timer">

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-light"
            android:text="30:00"
            android:textColor="@color/text_primary"
            android:textSize="52sp" />
    </FrameLayout>

    <!-- Quick resets -->
    <LinearLayout
        style="@style/Restudy.Card"
        android:layout_marginTop="32dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Try a quick reset" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- TODO: open a guided breathing screen/dialog -->
            <LinearLayout
                android:id="@+id/btnBreathe"
                style="@style/Restudy.ResetTile">

                <ImageView
                    style="@style/Restudy.ResetIcon"
                    android:backgroundTint="@color/leaf_container"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_leaf"
                    app:tint="@color/leaf" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Breathe" />
            </LinearLayout>

            <!-- TODO: show a "drink water" reminder -->
            <LinearLayout
                android:id="@+id/btnWater"
                style="@style/Restudy.ResetTile">

                <ImageView
                    style="@style/Restudy.ResetIcon"
                    android:backgroundTint="@color/info_container"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_water"
                    app:tint="@color/water_icon" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Drink water" />
            </LinearLayout>

            <!-- TODO: open a music app -->
            <LinearLayout
                android:id="@+id/btnMusic"
                style="@style/Restudy.ResetTile">

                <ImageView
                    style="@style/Restudy.ResetIcon"
                    android:backgroundTint="@color/mood_container"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music"
                    app:tint="@color/music_icon" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Play music" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnEndEarly"
        style="@style/Restudy.Button.Neutral"
        android:text="End early" />

    <TextView
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Duration is tracked automatically." />

</LinearLayout>
