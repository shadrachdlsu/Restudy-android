<?xml version="1.0" encoding="utf-8"?>
<!-- Check-in, reused for BEFORE and AFTER lockdown.
     Java swaps txtPhase / txtTitle / txtSubtitle depending on which one it is. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Restudy.Screen"
    android:fillViewport="true"
    tools:context=".CheckInActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/txtPhase"
            style="@style/Restudy.Pill.Accent"
            android:text="Before lockdown" />

        <TextView
            android:id="@+id/txtTitle"
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="How are you right now?" />

        <TextView
            android:id="@+id/txtSubtitle"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="A quick check-in before your 30-minute recovery block." />

        <!-- Stress level -->
        <LinearLayout
            style="@style/Restudy.Card"
            android:layout_marginTop="28dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stress level" />

            <!-- Order matters: dot, line, dot, ... (Java reads dots at even indexes) -->
            <LinearLayout
                android:id="@+id/scaleStress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Stress level 1 of 5"
                    android:text="1" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Stress level 2 of 5"
                    android:text="2" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Stress level 3 of 5"
                    android:text="3" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Stress level 4 of 5"
                    android:text="4" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Stress level 5 of 5"
                    android:text="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calm" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Stressed" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mood -->
        <LinearLayout
            style="@style/Restudy.Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mood" />

            <!-- Order matters: dot, line, dot, ... (Java reads dots at even indexes) -->
            <LinearLayout
                android:id="@+id/scaleMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Mood 1 of 5"
                    android:text="1" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Mood 2 of 5"
                    android:text="2" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Mood 3 of 5"
                    android:text="3" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Mood 4 of 5"
                    android:text="4" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Mood 5 of 5"
                    android:text="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Low" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Good" />
            </LinearLayout>
        </LinearLayout>

        <!-- Energy level -->
        <LinearLayout
            style="@style/Restudy.Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Energy level" />

            <!-- Order matters: dot, line, dot, ... (Java reads dots at even indexes) -->
            <LinearLayout
                android:id="@+id/scaleEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Energy level 1 of 5"
                    android:text="1" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Energy level 2 of 5"
                    android:text="2" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Energy level 3 of 5"
                    android:text="3" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Energy level 4 of 5"
                    android:text="4" />
                <View style="@style/Restudy.ScaleLine" />
                <TextView
                    style="@style/Restudy.ScaleDot"
                    android:contentDescription="Energy level 5 of 5"
                    android:text="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Drained" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Energized" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <TextView
            android:id="@+id/btnStart"
            style="@style/Restudy.Button.Primary"
            android:text="Start" />

        <TextView
            android:id="@+id/btnAnswerLater"
            style="@style/Restudy.Button.Text"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Answer later" />
    </LinearLayout>
</ScrollView>
