<?xml version="1.0" encoding="utf-8"?>
<!-- What changed: before vs after averages, weekdays / weekends.
     Bars are plain Views; Java sets their height (value / 5 * chart height). Hard-coded for now. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Restudy.Screen"
    android:fillViewport="true"
    tools:context=".WhatChangedActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Restudy.Pill.Accent"
            android:text="Reflection stage" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What changed?" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_compare"
                app:tint="@color/text_tertiary" />
        </LinearLayout>

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your average levels before and after the intervention period." />

        <!-- Weekdays / Weekends toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabWeekdays"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Weekdays"
                android:textColor="@color/segment_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tabWeekends"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Weekends"
                android:textColor="@color/segment_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Chart -->
        <LinearLayout
            style="@style/Restudy.Card"
            android:layout_marginTop="12dp">

            <!-- Legend -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/bar_before" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Before" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/bar_after" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="After" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Scale 1–5" />
            </LinearLayout>

            <!-- Bars (max height 140dp = 5.0) -->
            <LinearLayout
                android:id="@+id/chartBars"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Stress -->
                <LinearLayout style="@style/Restudy.BarGroup">

                    <LinearLayout style="@style/Restudy.BarColumn">
                        <TextView
                            android:id="@+id/valStressBefore"
                            style="@style/Restudy.BarValue"
                            android:text="3.7" />
                        <View
                            android:id="@+id/barStressBefore"
                            style="@style/Restudy.Bar"
                            android:layout_height="104dp"
                            android:backgroundTint="@color/bar_before" />
                    </LinearLayout>

                    <LinearLayout style="@style/Restudy.BarColumn">
                        <TextView
                            android:id="@+id/valStressAfter"
                            style="@style/Restudy.BarValue"
                            android:text="3.0" />
                        <View
                            android:id="@+id/barStressAfter"
                            style="@style/Restudy.Bar"
                            android:layout_height="84dp"
                            android:backgroundTint="@color/bar_after" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mood -->
                <LinearLayout style="@style/Restudy.BarGroup">

                    <LinearLayout style="@style/Restudy.BarColumn">
                        <TextView
                            android:id="@+id/valMoodBefore"
                            style="@style/Restudy.BarValue"
                            android:text="2.5" />
                        <View
                            android:id="@+id/barMoodBefore"
                            style="@style/Restudy.Bar"
                            android:layout_height="70dp"
                            android:backgroundTint="@color/bar_before" />
                    </LinearLayout>

                    <LinearLayout style="@style/Restudy.BarColumn">
                        <TextView
                            android:id="@+id/valMoodAfter"
                            style="@style/Restudy.BarValue"
                            android:text="3.22" />
                        <View
                            android:id="@+id/barMoodAfter"
                            style="@style/Restudy.Bar"
                            android:layout_height="90dp"
                            android:backgroundTint="@color/bar_after" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Burnout -->
                <LinearLayout style="@style/Restudy.BarGroup">

                    <LinearLayout style="@style/Restudy.BarColumn">
                        <TextView
                            android:id="@+id/valBurnoutBefore"
                            style="@style/Restudy.BarValue"
                            android:text="3.6" />
                        <View
                            android:id="@+id/barBurnoutBefore"
                            style="@style/Restudy.Bar"
                            android:layout_height="101dp"
                            android:backgroundTint="@color/bar_before" />
                    </LinearLayout>

                    <LinearLayout style="@style/Restudy.BarColumn">
                        <TextView
                            android:id="@+id/valBurnoutAfter"
                            style="@style/Restudy.BarValue"
                            android:text="3.22" />
                        <View
                            android:id="@+id/barBurnoutAfter"
                            style="@style/Restudy.Bar"
                            android:layout_height="90dp"
                            android:backgroundTint="@color/bar_after" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Baseline -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke" />

            <!-- Category labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Stress" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Mood" />

                <TextView
                    style="@style/Restudy.ScaleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Burnout" />
            </LinearLayout>
        </LinearLayout>

        <!-- How to read -->
        <LinearLayout
            style="@style/Restudy.Card"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_tint"
            android:backgroundTint="@color/info_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info"
                app:tint="@color/info_text" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Higher mood is positive. Lower stress and burnout are positive."
                android:textColor="@color/info_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Insight -->

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <!-- TODO: timeline screen ("when these changes happened") -->
        <TextView
            android:id="@+id/btnTimeline"
            style="@style/Restudy.Button.Primary"
            android:text="See when these changes happened" />

        <!-- Back to home, closes the cycle -->
        <TextView
            android:id="@+id/btnBackToStart"
            style="@style/Restudy.Button.Text"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Back to start"
            android:textColor="@color/on_primary_container" />
    </LinearLayout>
</ScrollView>
