<?xml version="1.0" encoding="utf-8"?>
<!-- Session setup: confirms when the lockdown is happening before the check-in. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Restudy.Screen"
    android:fillViewport="true"
    tools:context=".SessionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time to unplug" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Here's the session you're about to start." />

        <!-- Session details -->
        <LinearLayout
            style="@style/Restudy.Card"
            android:layout_marginTop="28dp">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session details" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- TODO: set from the current date -->
                <TextView
                    android:id="@+id/chipDay"
                    style="@style/Restudy.Pill"
                    android:text="Today" />

                <!-- TODO: set from the current time (Morning / Afternoon / Evening) -->
                <TextView
                    android:id="@+id/chipTime"
                    style="@style/Restudy.Pill"
                    android:layout_marginStart="8dp"
                    android:text="Evening" />
            </LinearLayout>

            <TextView
                android:id="@+id/chipTrigger"
                style="@style/Restudy.Pill"
                android:layout_marginTop="8dp"
                android:text="After requirement completion" />
        </LinearLayout>

        <!-- Lockdown summary -->
        <LinearLayout
            style="@style/Restudy.Card"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_tint"
            android:backgroundTint="@color/primary_container"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_tile"
                android:contentDescription="@null"
                android:padding="18dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Doomscroll Lockdown" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="30 minutes · distracting apps paused" />

            <TextView
                android:id="@+id/txtSessionLabel"
                style="@style/Restudy.Pill"
                android:layout_marginTop="14dp"
                android:backgroundTint="#B3FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:text="Today · Evening session"
                android:textColor="@color/on_primary_container" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <TextView
            android:id="@+id/btnReady"
            style="@style/Restudy.Button.Primary"
            android:text="Ready to begin" />

        <TextView
            android:id="@+id/btnNotYet"
            style="@style/Restudy.Button.Neutral"
            android:layout_marginTop="10dp"
            android:text="Not yet" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Date and time are saved automatically." />
    </LinearLayout>
</ScrollView>
